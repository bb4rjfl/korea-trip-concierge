{
  "name": "korea-trip-concierge",
  "version": "0.1.0",
  "private": true,
  "description": "Korea Trip Concierge — MCP server helping foreign visitors in Korea (places, foreigner-friendly stores, transit, payment). Agentic Player 10.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:naming": "tsx scripts/lint-naming.ts",
    "build": "npm run lint:naming && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:web": "tsx watch web/server/index.ts",
    "dev:web:client": "vite -c web/client/vite.config.ts",
    "build:web": "tsc -p tsconfig.web.json && vite build -c web/client/vite.config.ts",
    "start:web": "node dist-web/web/server/index.js",
    "inspect": "npx -y @modelcontextprotocol/inspector",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.4.13",
    "express": "^5.1.0",
    "marked": "^18.0.9",
    "preact": "^10.29.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
